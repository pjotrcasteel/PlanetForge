@using PlanetForge.Domain.Atmosphere
@using PlanetForge.Domain.Hydrology
@using PlanetForge.Domain.Physics
@implements IAsyncDisposable
@inject PlanetExperience Experience
@inject IJSRuntime JsRuntime

<main class="game-shell">
    <section class="hero-copy">
        <div>
            <span class="eyebrow">MILESTONE 0.0.4 · CLIMATE FEEDBACK</span>
            <h1>PlanetForge</h1>
            <p>Change the forcing, then advance time. Temperature now responds with inertia while ice changes the effective albedo and feeds back into the planet's energy balance.</p>
        </div>
        <div class="seed-chip">BUILD 0.0.4 · SEED @snapshot?.Seed</div>
    </section>

    <section class="planet-stage">
        <canvas id="planet-canvas" aria-label="Interactive low-poly planet"></canvas>
        <div class="stage-metrics">
            <span>@FormatSurfaceTemperature()</span>
            <span>@FormatSimulationYear()</span>
            <span>@FormatWaterState()</span>
        </div>
        <div class="stage-hint">DRAG TO ORBIT · SCROLL / PINCH TO ZOOM</div>
    </section>

    <section class="section-heading">
        <div>
            <span class="eyebrow">CLIMATE TIMELINE</span>
            <h2>Advance the planet through time</h2>
        </div>
        <button class="reset-button" @onclick="ResetEarthReferenceAsync">Reset Earth reference</button>
    </section>

    <section class="control-grid">
        <article class="control-card accent-card">
            <span class="control-label">SIMULATION TIME</span>
            <strong>@FormatSimulationYear()</strong>
            <small>Boundary changes set the forcing; time reveals the response</small>
            <div class="button-row">
                <button @onclick="AdvanceOneYearAsync">+1 year</button>
                <button @onclick="AdvanceTenYearsAsync">+10 years</button>
                <button @onclick="AdvanceFiftyYearsAsync">+50 years</button>
            </div>
        </article>

        <article class="control-card accent-card">
            <span class="control-label">THERMAL RESPONSE</span>
            <strong>@FormatSurfaceTemperature()</strong>
            <small>Target @FormatTargetSurfaceTemperature() · @FormatTemperatureGap()</small>
        </article>

        <article class="control-card accent-card">
            <span class="control-label">ICE → ALBEDO FEEDBACK</span>
            <strong>@FormatCryosphere()</strong>
            <small>Effective albedo @FormatEffectiveAlbedo() · @FormatIceAlbedoContribution()</small>
        </article>
    </section>

    <section class="section-heading compact-heading">
        <div>
            <span class="eyebrow">COUPLED SYSTEMS</span>
            <h2>Change the environmental forcing</h2>
        </div>
    </section>

    <section class="control-grid">
        <article class="control-card accent-card">
            <span class="control-label">ATMOSPHERIC MASS</span>
            <strong>@FormatAtmosphereMass()</strong>
            <small>@FormatPressure() mean surface pressure</small>
            <div class="button-row">
                <button @onclick="DecreaseAtmosphereMassAsync">Remove gas</button>
                <button @onclick="IncreaseAtmosphereMassAsync">Add gas</button>
            </div>
        </article>

        <article class="control-card accent-card">
            <span class="control-label">CARBON DIOXIDE</span>
            <strong>@FormatCarbonDioxide()</strong>
            <small>@FormatCarbonDioxideForcing() radiative forcing</small>
            <div class="button-row">
                <button @onclick="HalveCarbonDioxideAsync">½ CO₂</button>
                <button @onclick="DoubleCarbonDioxideAsync">2× CO₂</button>
            </div>
        </article>

        <article class="control-card accent-card">
            <span class="control-label">TOTAL WATER</span>
            <strong>@FormatWaterInventory()</strong>
            <small>@FormatWaterFractions()</small>
            <div class="button-row">
                <button @onclick="DecreaseWaterAsync">− Water</button>
                <button @onclick="IncreaseWaterAsync">+ Water</button>
            </div>
        </article>
    </section>

    <section class="section-heading compact-heading">
        <div>
            <span class="eyebrow">STAR & PLANET</span>
            <h2>Change the physical boundary conditions</h2>
        </div>
    </section>

    <section class="control-grid physics-controls">
        <article class="control-card">
            <span class="control-label">ORBITAL DISTANCE</span>
            <strong>@FormatOrbitalDistance()</strong>
            <small>Inverse-square stellar irradiance</small>
            <div class="button-row">
                <button @onclick="MoveOrbitInwardAsync">Toward star</button>
                <button @onclick="MoveOrbitOutwardAsync">Away from star</button>
            </div>
        </article>

        <article class="control-card">
            <span class="control-label">STELLAR LUMINOSITY</span>
            <strong>@FormatStellarLuminosity()</strong>
            <small>@FormatSolarFlux() at the planet</small>
            <div class="button-row">
                <button @onclick="DimStarAsync">Dim</button>
                <button @onclick="BrightenStarAsync">Brighten</button>
            </div>
        </article>

        <article class="control-card">
            <span class="control-label">BASE BOND ALBEDO</span>
            <strong>@FormatAlbedo()</strong>
            <small>Effective @FormatEffectiveAlbedo() after cryosphere feedback</small>
            <div class="button-row">
                <button @onclick="DarkenSurfaceAsync">Darken</button>
                <button @onclick="BrightenSurfaceAsync">Brighten</button>
            </div>
        </article>

        <article class="control-card">
            <span class="control-label">PLANET MASS</span>
            <strong>@FormatMass()</strong>
            <small>Changes gravity and atmospheric pressure</small>
            <div class="button-row">
                <button @onclick="DecreaseMassAsync">− Mass</button>
                <button @onclick="IncreaseMassAsync">+ Mass</button>
            </div>
        </article>

        <article class="control-card">
            <span class="control-label">PLANET RADIUS</span>
            <strong>@FormatRadius()</strong>
            <small>Changes gravity, density and surface area</small>
            <div class="button-row">
                <button @onclick="DecreaseRadiusAsync">− Radius</button>
                <button @onclick="IncreaseRadiusAsync">+ Radius</button>
            </div>
        </article>

        <article class="control-card">
            <span class="control-label">TERRAIN SEED</span>
            <strong>@snapshot?.Seed</strong>
            <small>Same systems, another procedural surface</small>
            <button class="wide-button" @onclick="ReseedAsync">Forge another surface</button>
        </article>
    </section>

    <section class="section-heading compact-heading">
        <div>
            <span class="eyebrow">SIMULATION STATE</span>
            <h2>What the coupled model produces</h2>
        </div>
    </section>

    <section class="stat-grid">
        <article class="stat-card"><span>Surface temperature</span><strong>@FormatSurfaceTemperature()</strong><small>Time-stepped climate state</small></article>
        <article class="stat-card"><span>Target temperature</span><strong>@FormatTargetSurfaceTemperature()</strong><small>Current forcing + effective albedo</small></article>
        <article class="stat-card"><span>Cryosphere</span><strong>@FormatCryosphere()</strong><small>Simplified global ice/snow coverage proxy</small></article>
        <article class="stat-card"><span>Effective albedo</span><strong>@FormatEffectiveAlbedo()</strong><small>Base reflectivity + ice feedback</small></article>
        <article class="stat-card"><span>Equilibrium temperature</span><strong>@FormatEquilibriumTemperature()</strong><small>Zero-greenhouse radiative baseline</small></article>
        <article class="stat-card"><span>Surface pressure</span><strong>@FormatPressure()</strong><small>p = Mₐg / 4πR²</small></article>
        <article class="stat-card"><span>Liquid water</span><strong>@FormatLiquidWater()</strong><small>Pressure/temperature phase model</small></article>
        <article class="stat-card"><span>Ice</span><strong>@FormatIce()</strong><small>Fraction of total water inventory</small></article>
        <article class="stat-card"><span>Water vapor</span><strong>@FormatVapor()</strong><small>Fraction of total water inventory</small></article>
        <article class="stat-card"><span>Surface gravity</span><strong>@FormatGravity()</strong><small>g = GM / R²</small></article>
        <article class="stat-card"><span>Escape velocity</span><strong>@FormatEscapeVelocity()</strong><small>vₑ = √(2GM / R)</small></article>
        <article class="stat-card"><span>Water boiling point</span><strong>@FormatBoilingPoint()</strong><small>Pressure-dependent approximation</small></article>
    </section>

    <section class="science-panel">
        <div class="science-copy">
            <span class="eyebrow">MODEL TRANSPARENCY</span>
            <h2>Real feedback, deliberately simple global model</h2>
            <p>Ice and snow reflect more sunlight than darker land and ocean, creating a positive surface-albedo feedback. PlanetForge models that real mechanism while keeping the global cryosphere fraction, thermal response time and maximum ice-albedo contribution explicit simplifications rather than pretending this is a full climate model.</p>
        </div>
        <div class="formula-list">
            <div><span>Physical relation</span><code>p = Mₐg / 4πR²</code></div>
            <div><span>Empirical</span><code>ΔF = 5.35 ln(C / C₀)</code></div>
            <div><span>Feedback model</span><code>αeff = αbase + 0.28 · fcryosphere</code></div>
            <div><span>Thermal inertia</span><code>dT/dt = (Ttarget − T) / τ</code></div>
        </div>
    </section>

    <footer>
        <span>TIME-STEPPED C# CLIMATE</span>
        <span>WEBGL RENDERER</span>
        <span>NO COMMERCIAL ENGINE</span>
    </footer>
</main>

@code {
    private readonly CancellationTokenSource disposeCancellationTokenSource = new();
    private IJSObjectReference? rendererModule;
    private PlanetRenderSnapshot? snapshot;

    protected override void OnInitialized() => snapshot = Experience.CreateSnapshot();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || snapshot is null)
        {
            return;
        }

        rendererModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", disposeCancellationTokenSource.Token, "./js/planetRenderer.js");
        await rendererModule.InvokeVoidAsync("initialize", disposeCancellationTokenSource.Token, "planet-canvas", snapshot, GetOrCreateSurfaceLodReference());
    }

    private Task AdvanceOneYearAsync() => UpdateAsync(Experience.AdvanceClimate(1.0));
    private Task AdvanceTenYearsAsync() => UpdateAsync(Experience.AdvanceClimate(10.0));
    private Task AdvanceFiftyYearsAsync() => UpdateAsync(Experience.AdvanceClimate(50.0));
    private Task MoveOrbitInwardAsync() => UpdateAsync(Experience.MoveOrbitInward());
    private Task MoveOrbitOutwardAsync() => UpdateAsync(Experience.MoveOrbitOutward());
    private Task DimStarAsync() => UpdateAsync(Experience.DimStar());
    private Task BrightenStarAsync() => UpdateAsync(Experience.BrightenStar());
    private Task DarkenSurfaceAsync() => UpdateAsync(Experience.DarkenSurface());
    private Task BrightenSurfaceAsync() => UpdateAsync(Experience.BrightenSurface());
    private Task DecreaseMassAsync() => UpdateAsync(Experience.DecreaseMass());
    private Task IncreaseMassAsync() => UpdateAsync(Experience.IncreaseMass());
    private Task DecreaseRadiusAsync() => UpdateAsync(Experience.DecreaseRadius());
    private Task IncreaseRadiusAsync() => UpdateAsync(Experience.IncreaseRadius());
    private Task DecreaseAtmosphereMassAsync() => UpdateAsync(Experience.DecreaseAtmosphereMass());
    private Task IncreaseAtmosphereMassAsync() => UpdateAsync(Experience.IncreaseAtmosphereMass());
    private Task HalveCarbonDioxideAsync() => UpdateAsync(Experience.HalveCarbonDioxide());
    private Task DoubleCarbonDioxideAsync() => UpdateAsync(Experience.DoubleCarbonDioxide());
    private Task DecreaseWaterAsync() => UpdateAsync(Experience.DecreaseWater());
    private Task IncreaseWaterAsync() => UpdateAsync(Experience.IncreaseWater());
    private Task ReseedAsync() => UpdateAsync(Experience.Reseed());
    private Task ResetEarthReferenceAsync() => UpdateAsync(Experience.ResetEarthReference());

    private async Task UpdateAsync(PlanetRenderSnapshot nextSnapshot)
    {
        snapshot = nextSnapshot;

        if (rendererModule is not null)
        {
            await rendererModule.InvokeVoidAsync("setPlanet", disposeCancellationTokenSource.Token, snapshot);
        }
    }

    private string FormatSimulationYear() => snapshot is null ? "—" : $"YEAR +{snapshot.ClimateFeedback.ElapsedYears:0}";
    private string FormatOrbitalDistance() => snapshot is null ? "—" : $"{snapshot.PhysicalParameters.OrbitalDistanceMeters / PhysicalConstants.AstronomicalUnitMeters:0.00} AU";
    private string FormatStellarLuminosity() => snapshot is null ? "—" : $"{snapshot.PhysicalParameters.StellarLuminosityWatts / PhysicalConstants.NominalSolarLuminosityWatts:0.0} L☉";
    private string FormatAlbedo() => snapshot is null ? "—" : $"{snapshot.PhysicalParameters.BondAlbedo * 100:0.0}%";
    private string FormatEffectiveAlbedo() => snapshot is null ? "—" : $"{snapshot.ClimateFeedback.EffectiveBondAlbedo * 100:0.0}%";
    private string FormatIceAlbedoContribution() => snapshot is null ? "—" : $"+{snapshot.ClimateFeedback.IceAlbedoContribution * 100:0.0} pp from ice";
    private string FormatCryosphere() => snapshot is null ? "—" : $"{snapshot.ClimateFeedback.CryosphereFraction * 100:0.0}% cover";
    private string FormatMass() => snapshot is null ? "—" : $"{snapshot.PhysicalParameters.MassKilograms / EarthReference.MassKilograms:0.0} M⊕";
    private string FormatRadius() => snapshot is null ? "—" : $"{snapshot.PhysicalParameters.RadiusMeters / EarthReference.MeanRadiusMeters:0.00} R⊕";
    private string FormatAtmosphereMass() => snapshot is null ? "—" : $"{snapshot.Atmosphere.EarthAtmosphereMasses:0.00} atm mass";
    private string FormatCarbonDioxide() => snapshot is null ? "—" : $"{snapshot.AtmosphereParameters.CarbonDioxidePartsPerMillion:0} ppm";
    private string FormatCarbonDioxideForcing() => snapshot is null ? "—" : $"{snapshot.Atmosphere.CarbonDioxideRadiativeForcingWattsPerSquareMeter:+0.00;-0.00;0.00} W/m²";
    private string FormatWaterInventory() => snapshot is null ? "—" : $"{snapshot.WaterParameters.TotalMassKilograms / EarthWaterReference.TotalHydrosphereMassKilograms:0.00} Earth oceans";
    private string FormatWaterFractions() => snapshot is null ? "—" : $"{snapshot.Water.IceFraction * 100:0}% ice · {snapshot.Water.LiquidFraction * 100:0}% liquid · {snapshot.Water.VaporFraction * 100:0}% vapor";
    private string FormatPressure() => snapshot is null ? "—" : $"{snapshot.Atmosphere.SurfacePressurePascals / 100_000.0:0.000} bar";
    private string FormatSolarFlux() => snapshot is null ? "—" : $"{snapshot.Physics.SolarFluxWattsPerSquareMeter:0} W/m²";
    private string FormatGravity() => snapshot is null ? "—" : $"{snapshot.Physics.SurfaceGravityMetersPerSecondSquared:0.00} m/s²";
    private string FormatEscapeVelocity() => snapshot is null ? "—" : $"{snapshot.Physics.EscapeVelocityMetersPerSecond / 1000.0:0.00} km/s";
    private string FormatLiquidWater() => snapshot is null ? "—" : $"{snapshot.Water.LiquidFraction * 100:0.0}%";
    private string FormatIce() => snapshot is null ? "—" : $"{snapshot.Water.IceFraction * 100:0.0}%";
    private string FormatVapor() => snapshot is null ? "—" : $"{snapshot.Water.VaporFraction * 100:0.0}%";
    private string FormatBoilingPoint() => snapshot is null ? "—" : $"{snapshot.Water.BoilingPointKelvin:0.0} K";
    private string FormatTargetSurfaceTemperature() => snapshot is null ? "—" : FormatTemperature(snapshot.ClimateFeedback.TargetSurfaceTemperatureKelvin);

    private string FormatTemperatureGap()
    {
        if (snapshot is null)
        {
            return "—";
        }

        var gap = snapshot.ClimateFeedback.TargetSurfaceTemperatureKelvin - snapshot.Climate.SurfaceTemperatureKelvin;
        return $"{gap:+0.0;-0.0;0.0} K from target";
    }

    private string FormatEquilibriumTemperature()
    {
        if (snapshot is null)
        {
            return "—";
        }

        return FormatTemperature(snapshot.Physics.EquilibriumTemperatureKelvin);
    }

    private string FormatSurfaceTemperature()
    {
        if (snapshot is null)
        {
            return "—";
        }

        return FormatTemperature(snapshot.Climate.SurfaceTemperatureKelvin);
    }

    private string FormatWaterState()
    {
        if (snapshot is null || snapshot.WaterParameters.TotalMassKilograms <= 0.0)
        {
            return "DRY";
        }

        if (snapshot.Water.LiquidFraction >= snapshot.Water.IceFraction && snapshot.Water.LiquidFraction >= snapshot.Water.VaporFraction)
        {
            return "LIQUID WATER";
        }

        return snapshot.Water.IceFraction >= snapshot.Water.VaporFraction ? "ICE WORLD" : "STEAM WORLD";
    }

    private static string FormatTemperature(double kelvin)
    {
        var celsius = kelvin - PhysicalConstants.KelvinOffsetCelsius;
        return $"{kelvin:0} K · {celsius:+0;-0;0}°C";
    }

    public async ValueTask DisposeAsync()
    {
        disposeCancellationTokenSource.Cancel();

        if (rendererModule is not null)
        {
            try
            {
                await rendererModule.InvokeVoidAsync("dispose", CancellationToken.None);
                await rendererModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        DisposeSurfaceLodReference();
        disposeCancellationTokenSource.Dispose();
    }
}