@using PlanetForge.Application.Missions
@using PlanetForge.Application.Runs
@using PlanetForge.Application.Surface
@using PlanetForge.Domain.WorldGeneration
@using PlanetForge.Domain.Origins
@using PlanetForge.Domain.Surface
@using PlanetForge.Infrastructure.Surface
@implements IAsyncDisposable
@inject PlanetExperience Experience
@inject PlanetRun Run
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@inject PlanetGeologicalCameraRegionStream RegionStream
@inject PlanetTerrainRegionProvider TerrainProvider

<main class="foundation-shell">
    <section class="planet-stage foundation-stage @PlanetVisualClass()">
        <canvas id="planet-canvas" aria-label="Interactive simulated planet"></canvas>
        <canvas id="water-overlay-canvas" aria-hidden="true"></canvas>

        <div class="foundation-clock @(geologyActive ? "foundation-clock-geology" : airlessReferenceActive ? "foundation-clock-thermal" : "")" aria-live="polite">
            <strong>@FormatElapsedTime()</strong>
            <span>@FormatStageLabel()</span>
            <small class="foundation-geology-preview" data-testid="planet-scenario-label" title="@CurrentScenarioName">@(rockColumnsActive ? "ROCK COLUMNS · SURFACE AND DEPTH" : magmaOceanActive ? "MAGMA OCEAN · CONSERVED MOLTEN REFERENCE" : regionalRockActive ? "REGIONAL ROCK · CONSERVED PHASE REFERENCE" : airlessReferenceActive ? "AIRLESS · ONE-ZONE PHYSICAL REFERENCE" : snapshot?.Origin is not null ? PlanetOriginUxText.ScenarioLabel : geologyActive ? "EXPERIMENT / PHYSICAL TERRAIN" : "EXPERIMENT / CANONICAL TERRAIN")</small>
            <div class="foundation-seed">
                <small data-testid="planet-seed">SEED @CurrentSeed</small>
                @if (!airlessReferenceActive)
                {
                <button class="foundation-generate" data-testid="geology-terrain-toggle" type="button"
                        aria-label="Toggle geological deformation in the main 3D planet"
                        aria-pressed="@(geologyActive ? "true" : "false")" disabled="@(isTransitioning || geologyLoading)"
                        @onclick="ToggleGeologyAsync">@(geologyLoading ? "BUILDING…" : geologyActive ? "GEOLOGY ON" : "GEOLOGY OFF")</button>
                @if (regionalStreamingEnabled)
                {
                    <small data-testid="region-stream-status" aria-live="polite">@regionalStreamStatus</small>
                }
                <button class="foundation-generate" disabled="@(isTransitioning || geologyLoading)" aria-label="Generate new planet" @onclick="GeneratePlanetAsync">GENERATE</button>
                }
            </div>
            @if (geologyActive && geologyTimeline is not null)
            {
                <div class="foundation-geology-epochs" data-testid="main-geology-epochs" aria-label="Geological crust research timeline">
                    <button data-testid="main-geology-previous" aria-label="Older crust research epoch" type="button"
                            disabled="@(isTransitioning || geologyLoading || geologyFrameIndex == 0)"
                            aria-busy="@(geologyLoadingDirection == -1 ? "true" : "false")"
                            @onclick="() => SelectGeologyEpochAsync(-1)">
                        @if (geologyLoadingDirection == -1)
                        {
                            <span class="foundation-epoch-spinner" role="status" aria-label="Loading older crust epoch" data-testid="main-geology-spinner" />
                        }
                        else
                        {
                            <span aria-hidden="true">◀</span>
                        }
                    </button>
                    <strong data-testid="main-geology-epoch">@(geologyTimeline[geologyFrameIndex].Epoch.YearsBeforePresent / 1_000_000) Ma AGO</strong>
                    <button data-testid="main-geology-next" aria-label="Younger crust research epoch" type="button"
                            disabled="@(isTransitioning || geologyLoading || geologyFrameIndex == geologyTimeline.Count - 1)"
                            aria-busy="@(geologyLoadingDirection == 1 ? "true" : "false")"
                            @onclick="() => SelectGeologyEpochAsync(1)">
                        @if (geologyLoadingDirection == 1)
                        {
                            <span class="foundation-epoch-spinner" role="status" aria-label="Loading newer crust epoch" data-testid="main-geology-spinner" />
                        }
                        else
                        {
                            <span aria-hidden="true">▶</span>
                        }
                    </button>
                </div>
            }
            @if (airlessReferenceActive && snapshot?.Origin is { } thermal)
            {
                <div class="foundation-thermal-readout" data-testid="airless-reference-readout">
                    @if (regionalRockActive && Experience.PublishedRegionalRock is { } region)
                    {
                        <strong data-testid="regional-temperature-range">SURFACE @($"{region.Field.Cells.Min(x => region.ResolveSurfacePhase(x.Id).TemperatureKelvin):0}")–@($"{region.Field.Cells.Max(x => region.ResolveSurfacePhase(x.Id).TemperatureKelvin):0}") K</strong>
                        <span data-testid="regional-melt-range">MELT @($"{region.Field.Cells.Min(x => region.ResolveSurfacePhase(x.Id).MeltFraction):P0}")–@($"{region.Field.Cells.Max(x => region.ResolveSurfacePhase(x.Id).MeltFraction):P0}")</span>
                    }
                    else
                    {
                        <strong data-testid="airless-surface-temperature">SURFACE @($"{thermal.NearSurfaceRockTemperatureKelvin:0}") K</strong>
                        <span data-testid="airless-mantle-temperature">MANTLE @($"{thermal.BulkRockTemperatureKelvin:0}") K · @($"{thermal.BulkRockMeltFraction:P0}") MELT</span>
                    }
                    <small data-testid="airless-elapsed">T+@(airlessElapsedSeconds / 3600)h · REV @thermal.Revision</small>
                    @if (rockColumnsActive && Experience.PublishedRegionalRock?.Columns is { } columns)
                    {
                        <span data-testid="column-solid-thickness">SOLID TOP @($"{columns.Columns.Min(c => c.SolidSurfaceThicknessMeters(columns.Material, columns.Properties)):0.00}")–@($"{columns.Columns.Max(c => c.SolidSurfaceThicknessMeters(columns.Material, columns.Properties)):0.00}") m</span>
                        <small data-testid="column-deep-melt">DEEP MELT @($"{columns.Columns.Min(c => c.Layers[^1].Resolve(columns.Material).MeltFraction):P0}")–@($"{columns.Columns.Max(c => c.Layers[^1].Resolve(columns.Material).MeltFraction):P0}")</small>
                    }
                    <small class="foundation-thermal-limit">@(rockColumnsActive ? "DRY THIN SHELL · TECTONICS NOT MODELED" : magmaOceanActive ? "HYPOTHETICAL MOLTEN SURFACE · NOT CRUST" : regionalRockActive ? "DECLARED THERMAL CONTRAST · NOT CRUST" : "UNIFORM ROCK TEMP · CRUST NOT MODELED")</small>
                    @if (!string.IsNullOrEmpty(airlessStatus))
                    {
                        <small role="status" data-testid="airless-status">@airlessStatus</small>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(geologyStatus))
            {
                <small class="foundation-geology-status" role="status" data-testid="main-geology-status">@geologyStatus</small>
            }
        </div>

        @if (airlessReferenceActive)
        {
            <div class="foundation-controls foundation-thermal-controls">
                <button class="foundation-next" data-testid="airless-advance" type="button"
                        disabled="@airlessBusy" @onclick="AdvanceAirlessReferenceAsync">@(airlessBusy ? "INTEGRATING…" : "ADVANCE 1 HOUR")</button>
                <button class="foundation-reference-reset" data-testid="airless-reset" type="button"
                        disabled="@airlessBusy" @onclick="ResetAirlessReferenceAsync">RESET</button>
                <button class="foundation-reference-reset" data-testid="airless-exit" type="button"
                        disabled="@airlessBusy" @onclick="ExitAirlessReferenceAsync">BACK</button>
                <button class="foundation-reference-reset foundation-phase-switch" data-testid="regional-switch" type="button"
                        disabled="@airlessBusy" @onclick="SwitchRockReferenceAsync">@(regionalRockActive ? "UNIFORM REFERENCE" : rockColumnsSelected ? "ROCK COLUMN REFERENCE" : magmaOceanSelected ? "MAGMA OCEAN REFERENCE" : "REGIONAL PHASE TEST")</button>
            </div>
        }
        else
        {
            <div class="foundation-controls foundation-reference-entry">
                @if (!geologyActive && snapshot?.Origin is null)
                {
                    <button class="foundation-next" disabled="@(isTransitioning || geologyLoading)" @onclick="AdvanceAsync">@FormatButtonLabel()</button>
                }
                <button class="foundation-reference-reset foundation-open-reference" data-testid="airless-enter" type="button"
                        disabled="@(isTransitioning || geologyLoading || airlessBusy)"
                        @onclick="EnterAirlessReferenceAsync">HOT ROCK TEST</button>
            </div>
        }
    </section>
</main>

@code {
    private const int ClimateFrameDelayMilliseconds = 180;
    private const int MaximumClimateDisplayFrames = 7;
    private const int ClimateTransitionLeadInMilliseconds = 700;
    private const int HydrologyFrameDelayMilliseconds = 260;
    private const int ScaffoldFrameDelayMilliseconds = 65;
    private const int ScaffoldFrameCount = 36;
    private const int CrustResearchSteps = PlanetCrustAccumulatedDeformation.MaximumResearchSteps;

    private readonly CancellationTokenSource disposeCancellationTokenSource = new();
    private IJSObjectReference? archiveModule;
    private bool regionalStreamingEnabled;
    private bool regionalCatalogReady;
    private IReadOnlyList<PlanetGeologicalRegionId> regionalCatalog = [];
    private PlanetSurfaceView? lastRegionalCameraView;
    private string regionalStreamStatus = "REGION STREAM: INITIALIZING";
    private IJSObjectReference? rendererModule;
    private IJSObjectReference? waterRendererModule;
    private PlanetRenderSnapshot? snapshot;
    private PlanetRunSnapshot? run;
    private FoundationStage currentStage = FoundationStage.FrozenWorld;
    private FoundationStage? transitionStage;
    private bool isTransitioning;
    private bool geologyActive;
    private bool geologyLoading;
    private int geologyLoadingDirection;
    private IReadOnlyList<PlanetCrustEvolvingSnapshot>? geologyTimeline;
    private int geologyFrameIndex;
    private string geologyStatus = string.Empty;
    private bool airlessReferenceActive;
    private bool regionalRockActive;
    private bool rockColumnsSelected;
    private bool rockColumnsActive => rockColumnsSelected && regionalRockActive;
    private bool magmaOceanSelected;
    private bool magmaOceanActive => magmaOceanSelected && regionalRockActive;
    private bool airlessBusy;
    private int airlessElapsedSeconds;
    private string airlessStatus = string.Empty;
    private double elapsedYears;

    private int CurrentSeed => run?.Mission.Planet.Seed ?? PlanetSeedCatalog.ShowcaseSeed;
    private string CurrentScenarioName => rockColumnsActive
        ? "Dry/airless thin rock columns · physical surface cooling, freezing and contraction · no tectonics yet"
        : magmaOceanActive
        ? "Hypothetical initially fully molten surface shell · airless, conserved, not calibrated Hadean history"
        : regionalRockActive
        ? "Airless conserved regional phase-enthalpy · hypothetical initial heat contrast, not reconstructed Earth history"
        : airlessReferenceActive
        ? "Airless radiative-conduction reference · not a calibrated early-Earth history"
        : snapshot?.Origin is not null ? PlanetScenarioCatalog.EarthOrigin.Name : PlanetScenarioCatalog.CurrentPlayable.Name;

    protected override void OnInitialized()
    {
        regionalStreamingEnabled = new Uri(Navigation.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Contains("regionalStreaming=1", StringComparer.OrdinalIgnoreCase);
        var visualTestSeed = GetVisualTestSeed();
        ApplyRun(visualTestSeed.HasValue ? Run.StartNew(visualTestSeed.Value) : Run.StartNew());
        currentStage = FoundationStage.FrozenWorld;
        elapsedYears = 0.0;
        // Opt-in main-globe science check, never the default or legacy mission.
        // Only dry, airless physical rates are permitted by the process model.
        airlessReferenceActive = new Uri(Navigation.Uri).Query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Contains("airlessReference=1", StringComparer.OrdinalIgnoreCase);
        rockColumnsSelected = new Uri(Navigation.Uri).Query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Contains("rockColumns=1", StringComparer.OrdinalIgnoreCase);
        magmaOceanSelected = new Uri(Navigation.Uri).Query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Contains("magmaOcean=1", StringComparer.OrdinalIgnoreCase);
        regionalRockActive = rockColumnsSelected || magmaOceanSelected || new Uri(Navigation.Uri).Query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Contains("regionalRock=1", StringComparer.OrdinalIgnoreCase);
        airlessReferenceActive |= regionalRockActive;
        if (airlessReferenceActive && regionalRockActive)
        {
            _ = Experience.PublishRegionalRock(CreateSelectedRockReference(Experience.CreateInitialRenderSnapshot().PhysicalParameters.RadiusMeters));
            snapshot = Experience.CreateInitialRenderSnapshot();
        }
        else if (airlessReferenceActive)
        {
            // The first WebGL upload requires complete geometry. A regular
            // epoch publication is allowed to contain cached mesh deltas,
            // which would be invalid before the renderer has initialized.
            _ = Experience.PublishOriginEpoch(PlanetAirlessCoolingReference.CreateInitial());
            snapshot = Experience.CreateInitialRenderSnapshot();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || snapshot is null)
        {
            return;
        }

        rendererModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", disposeCancellationTokenSource.Token, "./js/planetRenderer.js");
        await rendererModule.InvokeVoidAsync("initialize", disposeCancellationTokenSource.Token, "planet-canvas", snapshot, GetOrCreateSurfaceLodReference());

        waterRendererModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", disposeCancellationTokenSource.Token, "./js/waterOverlay.js");
        await waterRendererModule.InvokeVoidAsync("initialize", disposeCancellationTokenSource.Token, "water-overlay-canvas", "planet-canvas", snapshot.PhysicalParameters.RadiusMeters);
        await waterRendererModule.InvokeVoidAsync("clearWaterCycle", disposeCancellationTokenSource.Token);
        if (regionalStreamingEnabled)
        {
            try
            {
                archiveModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", disposeCancellationTokenSource.Token, "./js/geologicalRegionStore.js");
                await LoadRegionalCatalogueAsync();
            }
            catch (Exception error)
            {
                regionalStreamStatus = $"REGION STREAM UNAVAILABLE: {error.Message}";
                StateHasChanged();
            }
        }
    }

    private async Task LoadRegionalCatalogueAsync()
    {
        regionalCatalogReady = false;
        regionalCatalog = [];
        if (archiveModule is null)
        {
            return;
        }

        var keys = await archiveModule.InvokeAsync<RegionalArchiveCatalogue>(
            "listPresentGeologicalRegions", disposeCancellationTokenSource.Token,
            CurrentSeed, PlanetGenerationVersion.Current.Value);
        regionalCatalog = keys.Keys
            .Select(key => PlanetGeologicalCameraRegionSelector.TryParsePresentArchiveKey(key, out var region) ? region : (PlanetGeologicalRegionId?)null)
            .Where(region => region.HasValue)
            .Select(region => region!.Value)
            .Distinct()
            .ToArray();
        regionalCatalogReady = true;
        regionalStreamStatus = keys.Truncated
            ? $"REGION STREAM: {regionalCatalog.Count}+ SAVED (INDEX LIMITED)"
            : $"REGION STREAM: {regionalCatalog.Count} SAVED";
        StateHasChanged();
    }

    private async Task ObserveRegionalCameraAsync(PlanetSurfaceView view, int seed)
    {
        try
        {
            var changed = await RegionStream.ObserveAsync(seed, view, regionalCatalog, disposeCancellationTokenSource.Token);
            if (!changed || seed != CurrentSeed || !regionalStreamingEnabled)
            {
                return;
            }

            await InvokeAsync(async () =>
            {
                // Revision-aware surface caches rebuild orbital and ground
                // geometry from one newly published geological snapshot.
                if (lastRegionalCameraView is not null)
                {
                    snapshot = EnsureLocalSurfaceDelivery(Experience.UpdateSurfaceView(lastRegionalCameraView));
                    await SyncPlanetAsync();
                }

                var active = RegionStream.ActiveRegion;
                regionalStreamStatus = active is null ? "REGION STREAM: CANONICAL TERRAIN" : $"REGION STREAM: {active.Value.Tile.Level} / SAVED GEOLOGY";
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // Camera moved, a newer request won, or this page was disposed.
        }
        catch (Exception error)
        {
            await InvokeAsync(() =>
            {
                regionalStreamStatus = $"REGION STREAM: {error.Message}";
                StateHasChanged();
            });
        }
    }

    private sealed record RegionalArchiveCatalogue(string[] Keys, bool Truncated);

    private int? GetVisualTestSeed()
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        var values = query.Split('&', StringSplitOptions.RemoveEmptyEntries);
        if (!values.Contains("visualTest=1", StringComparer.OrdinalIgnoreCase))
        {
            return null;
        }

        foreach (var value in values)
        {
            if (value.StartsWith("seed=", StringComparison.OrdinalIgnoreCase) && int.TryParse(value[5..], out var seed) && seed > 0)
            {
                return seed;
            }
        }

        return null;
    }

    /// <summary>
    /// Enter the already-tested, airless thermal reference from the main page,
    /// including when a separate geological research overlay is active.
    /// Keep one canonical planet and supply a complete first terrain snapshot.
    /// </summary>
    private async Task EnterAirlessReferenceAsync()
    {
        if (airlessReferenceActive || airlessBusy || geologyLoading || isTransitioning) return;
        airlessBusy = true;
        StateHasChanged();
        await Task.Yield();

        try
        {
            if (geologyActive)
            {
                TerrainProvider.ClearGlobalCrustDeformation();
                geologyActive = false;
                geologyTimeline = null;
                geologyFrameIndex = 0;
                geologyStatus = string.Empty;
                _ = Experience.InvalidateTerrain();
            }

            _ = Experience.PublishOriginEpoch(PlanetAirlessCoolingReference.CreateInitial());
            snapshot = Experience.CreateInitialRenderSnapshot();
            await SyncPlanetAsync();
            if (waterRendererModule is not null)
            {
                await waterRendererModule.InvokeVoidAsync("clearWaterCycle", disposeCancellationTokenSource.Token);
            }

            airlessReferenceActive = true;
            airlessElapsedSeconds = 0;
            airlessStatus = string.Empty;
        }
        catch (Exception error) when (error is not OperationCanceledException)
        {
            Experience.ClearOriginEpoch();
            snapshot = Experience.CreateInitialRenderSnapshot();
            await SyncPlanetAsync();
            geologyStatus = $"THERMAL REFERENCE UNAVAILABLE: {error.Message}";
        }
        finally
        {
            airlessBusy = false;
            StateHasChanged();
        }
    }

    private PlanetOriginCanonicalRockCells CreateSelectedRockReference(double radius) => rockColumnsSelected
        ? PlanetRockColumnReference.CreateInitial(radius)
        : magmaOceanSelected ? PlanetMagmaOceanReference.CreateInitial(radius) : PlanetRegionalCoolingReference.CreateInitial(radius);

    private async Task SwitchRockReferenceAsync()
    {
        if (!airlessReferenceActive || airlessBusy) return;
        airlessBusy = true;
        StateHasChanged();
        await Task.Yield();

        try
        {
            Experience.ClearOriginEpoch();
            regionalRockActive = !regionalRockActive;
            if (regionalRockActive)
            {
                var radius = Experience.CreateInitialRenderSnapshot().PhysicalParameters.RadiusMeters;
                _ = Experience.PublishRegionalRock(CreateSelectedRockReference(radius));
            }
            else
            {
                _ = Experience.PublishOriginEpoch(PlanetAirlessCoolingReference.CreateInitial());
            }

            snapshot = Experience.CreateInitialRenderSnapshot();
            await SyncPlanetAsync();
            if (waterRendererModule is not null)
                await waterRendererModule.InvokeVoidAsync("clearWaterCycle", disposeCancellationTokenSource.Token);
            airlessElapsedSeconds = 0;
            airlessStatus = "RESET";
        }
        catch (Exception error) when (error is not OperationCanceledException)
        {
            airlessStatus = $"PHASE SWITCH FAILED: {error.Message}";
        }
        finally
        {
            airlessBusy = false;
            StateHasChanged();
        }
    }

    private async Task ExitAirlessReferenceAsync()
    {
        if (!airlessReferenceActive || airlessBusy) return;
        airlessBusy = true;
        StateHasChanged();
        await Task.Yield();

        try
        {
            Experience.ClearOriginEpoch();
            snapshot = Experience.CreateInitialRenderSnapshot();
            await SyncPlanetAsync();
            if (waterRendererModule is not null)
            {
                await waterRendererModule.InvokeVoidAsync("clearWaterCycle", disposeCancellationTokenSource.Token);
            }

            airlessReferenceActive = false;
            regionalRockActive = false;
            rockColumnsSelected = false;
            magmaOceanSelected = false;
            airlessElapsedSeconds = 0;
            airlessStatus = string.Empty;
        }
