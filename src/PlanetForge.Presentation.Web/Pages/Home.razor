@using PlanetForge.Application.Missions
@using PlanetForge.Application.Runs
@using PlanetForge.Application.Surface
@using PlanetForge.Domain.WorldGeneration
@using PlanetForge.Domain.Origins
@using PlanetForge.Domain.Surface
@using PlanetForge.Infrastructure.Surface
@implements IAsyncDisposable
@inject PlanetExperience Experience
@inject PlanetRun Run
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@inject PlanetGeologicalCameraRegionStream RegionStream
@inject PlanetTerrainRegionProvider TerrainProvider

<main class="foundation-shell">
    <section class="planet-stage foundation-stage @PlanetVisualClass()">
        <canvas id="planet-canvas" aria-label="Interactive simulated planet"></canvas>
        <canvas id="water-overlay-canvas" aria-hidden="true"></canvas>

        <div class="foundation-clock" aria-live="polite">
            <strong>@FormatElapsedTime()</strong>
            <span>@FormatStageLabel()</span>
            <small class="foundation-geology-preview" data-testid="planet-scenario-label" title="@CurrentScenarioName">@(geologyActive ? "EXPERIMENT / PHYSICAL TERRAIN" : "EXPERIMENT / CANONICAL TERRAIN")</small>
            <div class="foundation-seed">
                <small data-testid="planet-seed">SEED @CurrentSeed</small>
                <button class="foundation-generate" data-testid="geology-terrain-toggle" type="button"
                        aria-label="Toggle geological deformation in the main 3D planet"
                        aria-pressed="@(geologyActive ? "true" : "false")" disabled="@(isTransitioning || geologyLoading)"
                        @onclick="ToggleGeologyAsync">@(geologyLoading ? "BUILDING…" : geologyActive ? "GEOLOGY ON" : "GEOLOGY OFF")</button>
                @if (regionalStreamingEnabled)
                {
                    <small data-testid="region-stream-status" aria-live="polite">@regionalStreamStatus</small>
                }
                <button class="foundation-generate" disabled="@(isTransitioning || geologyLoading)" aria-label="Generate new planet" @onclick="GeneratePlanetAsync">GENERATE</button>
            </div>
            @if (!string.IsNullOrEmpty(geologyStatus))
            {
                <small class="foundation-geology-status" role="status" data-testid="main-geology-status">@geologyStatus</small>
            }
        </div>

        <div class="foundation-controls">
            <button class="foundation-next" disabled="@(isTransitioning || geologyLoading)" @onclick="AdvanceAsync">@FormatButtonLabel()</button>
        </div>
    </section>
</main>

@code {
    private const int ClimateFrameDelayMilliseconds = 180;
    private const int MaximumClimateDisplayFrames = 7;
    private const int ClimateTransitionLeadInMilliseconds = 700;
    private const int HydrologyFrameDelayMilliseconds = 260;
    private const int ScaffoldFrameDelayMilliseconds = 65;
    private const int ScaffoldFrameCount = 36;

    private readonly CancellationTokenSource disposeCancellationTokenSource = new();
    private IJSObjectReference? archiveModule;
    private bool regionalStreamingEnabled;
    private bool regionalCatalogReady;
    private IReadOnlyList<PlanetGeologicalRegionId> regionalCatalog = [];
    private PlanetSurfaceView? lastRegionalCameraView;
    private string regionalStreamStatus = "REGION STREAM: INITIALIZING";
    private IJSObjectReference? rendererModule;
    private IJSObjectReference? waterRendererModule;
    private PlanetRenderSnapshot? snapshot;
    private PlanetRunSnapshot? run;
    private FoundationStage currentStage = FoundationStage.FrozenWorld;
    private FoundationStage? transitionStage;
    private bool isTransitioning;
    private bool geologyActive;
    private bool geologyLoading;
    private string geologyStatus = string.Empty;
    private double elapsedYears;

    private int CurrentSeed => run?.Mission.Planet.Seed ?? PlanetSeedCatalog.ShowcaseSeed;
    private string CurrentScenarioName => PlanetScenarioCatalog.CurrentPlayable.Name;

    protected override void OnInitialized()
    {
        regionalStreamingEnabled = new Uri(Navigation.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Contains("regionalStreaming=1", StringComparer.OrdinalIgnoreCase);
        var visualTestSeed = GetVisualTestSeed();
        ApplyRun(visualTestSeed.HasValue ? Run.StartNew(visualTestSeed.Value) : Run.StartNew());
        currentStage = FoundationStage.FrozenWorld;
        elapsedYears = 0.0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || snapshot is null)
        {
            return;
        }

        rendererModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", disposeCancellationTokenSource.Token, "./js/planetRenderer.js");
        await rendererModule.InvokeVoidAsync("initialize", disposeCancellationTokenSource.Token, "planet-canvas", snapshot, GetOrCreateSurfaceLodReference());

        waterRendererModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", disposeCancellationTokenSource.Token, "./js/waterOverlay.js");
        await waterRendererModule.InvokeVoidAsync("initialize", disposeCancellationTokenSource.Token, "water-overlay-canvas", "planet-canvas", snapshot.PhysicalParameters.RadiusMeters);
        await waterRendererModule.InvokeVoidAsync("clearWaterCycle", disposeCancellationTokenSource.Token);
        if (regionalStreamingEnabled)
        {
            try
            {
                archiveModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", disposeCancellationTokenSource.Token, "./js/geologicalRegionStore.js");
                await LoadRegionalCatalogueAsync();
            }
            catch (Exception error)
            {
                regionalStreamStatus = $"REGION STREAM UNAVAILABLE: {error.Message}";
                StateHasChanged();
            }
        }
    }

    private async Task LoadRegionalCatalogueAsync()
    {
        regionalCatalogReady = false;
        regionalCatalog = [];
        if (archiveModule is null)
        {
            return;
        }

        var keys = await archiveModule.InvokeAsync<RegionalArchiveCatalogue>(
            "listPresentGeologicalRegions", disposeCancellationTokenSource.Token,
            CurrentSeed, PlanetGenerationVersion.Current.Value);
        regionalCatalog = keys.Keys
            .Select(key => PlanetGeologicalCameraRegionSelector.TryParsePresentArchiveKey(key, out var region) ? region : (PlanetGeologicalRegionId?)null)
            .Where(region => region.HasValue)
            .Select(region => region!.Value)
            .Distinct()
            .ToArray();
        regionalCatalogReady = true;
        regionalStreamStatus = keys.Truncated
            ? $"REGION STREAM: {regionalCatalog.Count}+ SAVED (INDEX LIMITED)"
            : $"REGION STREAM: {regionalCatalog.Count} SAVED";
        StateHasChanged();
    }

    private async Task ObserveRegionalCameraAsync(PlanetSurfaceView view, int seed)
    {
        try
        {
            var changed = await RegionStream.ObserveAsync(seed, view, regionalCatalog, disposeCancellationTokenSource.Token);
            if (!changed || seed != CurrentSeed || !regionalStreamingEnabled)
            {
                return;
            }

            await InvokeAsync(async () =>
            {
                // Revision-aware surface caches rebuild orbital and ground
                // geometry from one newly published geological snapshot.
                if (lastRegionalCameraView is not null)
                {
                    snapshot = EnsureLocalSurfaceDelivery(Experience.UpdateSurfaceView(lastRegionalCameraView));
                    await SyncPlanetAsync();
                }

                var active = RegionStream.ActiveRegion;
                regionalStreamStatus = active is null ? "REGION STREAM: CANONICAL TERRAIN" : $"REGION STREAM: {active.Value.Tile.Level} / SAVED GEOLOGY";
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // Camera moved, a newer request won, or this page was disposed.
        }
        catch (Exception error)
        {
            await InvokeAsync(() =>
            {
                regionalStreamStatus = $"REGION STREAM: {error.Message}";
                StateHasChanged();
            });
        }
    }

    private sealed record RegionalArchiveCatalogue(string[] Keys, bool Truncated);

    private int? GetVisualTestSeed()
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        var values = query.Split('&', StringSplitOptions.RemoveEmptyEntries);
        if (!values.Contains("visualTest=1", StringComparer.OrdinalIgnoreCase))
        {
            return null;
        }

        foreach (var value in values)
        {
            if (value.StartsWith("seed=", StringComparison.OrdinalIgnoreCase) && int.TryParse(value[5..], out var seed) && seed > 0)
            {
                return seed;
            }
        }

        return null;
    }

    private async Task GeneratePlanetAsync()
    {
        if (isTransitioning || geologyLoading)
        {
            return;
        }

        BeginTransition(FoundationStage.FrozenWorld);
        await Task.Yield();

        try
        {
            var seed = CreateRandomSeed(CurrentSeed);
            if (geologyActive)
            {
                TerrainProvider.ClearGlobalCrustDeformation();
                geologyActive = false;
                geologyStatus = string.Empty;
            }

            if (regionalStreamingEnabled)
            {
                RegionStream.Reset();
                regionalCatalogReady = false;
            }
            ApplyRun(Run.StartNew(seed));
            if (regionalStreamingEnabled)
            {
                await LoadRegionalCatalogueAsync();
            }
            currentStage = FoundationStage.FrozenWorld;
            elapsedYears = 0.0;
            await SyncPlanetAsync();

            if (waterRendererModule is not null)
            {
                await waterRendererModule.InvokeVoidAsync("clearWaterCycle", disposeCancellationTokenSource.Token);
            }
        }
        finally
        {
            EndTransition();
        }
    }

    /// <summary>
    /// Compare baseline and physics-derived ACTUAL terrain on the same globe,
    /// using the identical revision-aware IPlanetElevationSource at all LODs.
    /// Builds the research field on demand to avoid a costly mobile startup.
    /// No extra page, diagnostic shader, height multiplier or saved-world change.
    /// </summary>
    private async Task ToggleGeologyAsync()
    {
        if (isTransitioning || geologyLoading)
        {
            return;
        }

        geologyLoading = true;
        geologyStatus = geologyActive ? "RESTORING CANONICAL TERRAIN" : "RECONSTRUCTING 2 MYR OF GEOLOGY";
        StateHasChanged();
        await Task.Delay(20, disposeCancellationTokenSource.Token);

        try
        {
            if (geologyActive)
            {
                TerrainProvider.ClearGlobalCrustDeformation();
                geologyActive = false;
                geologyStatus = "CANONICAL BEDROCK · GEOLOGY COMPARISON OFF";
            }
            else
            {
                var seed = CurrentSeed;
                var catalog = PlanetCrustParcelCatalog.Create(seed);
                var history = PlanetCrustOwnershipHistory.Create(catalog);
                var timeline = new PlanetCrustAccumulatedDeformation().Simulate(catalog, history, 2);
                disposeCancellationTokenSource.Token.ThrowIfCancellationRequested();
                if (seed != CurrentSeed)
                {
                    return;
                }

                var current = timeline[^1];
                TerrainProvider.PublishGlobalCrustDeformation(current);
                geologyActive = true;
                geologyStatus = $"REAL ELEVATION · 2 MYR · UP TO {current.MaximumAbsoluteSurfaceDisplacementMeters:0} M LOCAL COLUMN";
            }

            snapshot = Experience.InvalidateTerrain();
            await SyncPlanetAsync();
        }
        catch (Exception error) when (error is not OperationCanceledException)
        {
            if (geologyActive)
            {
                TerrainProvider.ClearGlobalCrustDeformation();
                geologyActive = false;
            }

            geologyStatus = $"GEOLOGY NOT AVAILABLE: {error.Message}";
            snapshot = Experience.InvalidateTerrain();
            await SyncPlanetAsync();
        }
        finally
        {
            geologyLoading = false;
            StateHasChanged();
        }
    }

    private static int CreateRandomSeed(int currentSeed)
    {
        int seed;
        do
        {
            seed = Random.Shared.Next(1, int.MaxValue);
        }
        while (seed == currentSeed);

        return seed;
    }

    private async Task AdvanceAsync()
    {
        if (isTransitioning)
        {
            return;
        }

        switch (currentStage)
        {
            case FoundationStage.FrozenWorld:
                await SimulateMeltingAsync();
                break;
            case FoundationStage.MeltingWorld:
                await SimulateWaterCycleAsync();
                break;
            case FoundationStage.ActiveWaterCycle:
                await SimulateScaffoldStageAsync(FoundationStage.FirstLife, 5_000_000.0);
                break;
            case FoundationStage.FirstLife:
                await SimulateScaffoldStageAsync(FoundationStage.MarineAnimals, 50_000_000.0);
                break;
            case FoundationStage.MarineAnimals:
                await SimulateScaffoldStageAsync(FoundationStage.LandVegetation, 100_000_000.0);
                break;
            case FoundationStage.LandVegetation:
                await SimulateScaffoldStageAsync(FoundationStage.LandAnimals, 50_000_000.0);
                break;
            case FoundationStage.LandAnimals:
                await ResetAsync();
                break;
            default:
                throw new ArgumentOutOfRangeException();
        }
    }

    private async Task SimulateMeltingAsync()
    {
        BeginTransition(FoundationStage.MeltingWorld);
        try
        {
            Run.QueueIntervention(MissionInterventionType.ReleaseCapturedCarbon);
            Run.QueueIntervention(MissionInterventionType.ReleaseCapturedCarbon);
            Run.QueueIntervention(MissionInterventionType.DarkenSurface);
            Run.QueueIntervention(MissionInterventionType.DarkenSurface);
            var result = Run.SimulateCommit();

            await Task.Delay(ClimateTransitionLeadInMilliseconds, disposeCancellationTokenSource.Token);
            var displayStride = Math.Max(1, (int)Math.Ceiling(result.Frames.Count / (double)MaximumClimateDisplayFrames));
            for (var frameIndex = 0; frameIndex < result.Frames.Count; frameIndex++)
            {
                var isFinalFrame = frameIndex == result.Frames.Count - 1;
                if (!isFinalFrame && frameIndex % displayStride != 0)
                {
                    continue;
                }

                disposeCancellationTokenSource.Token.ThrowIfCancellationRequested();
                var frame = result.Frames[frameIndex];
                elapsedYears = frame.Year;
                snapshot = frame.Planet;
                await SyncPlanetAsync();
                StateHasChanged();
                await Task.Delay(ClimateFrameDelayMilliseconds, disposeCancellationTokenSource.Token);
            }

            ApplyRun(result.Run);
            currentStage = FoundationStage.MeltingWorld;
            elapsedYears = result.Run.Mission.MissionYearsElapsed;
        }
        finally
        {
            EndTransition();
        }
    }

    private async Task SimulateWaterCycleAsync()
    {
        if (run?.Era != PlanetRunEra.WaterWorld)
        {
            throw new InvalidOperationException("The deterministic melting transition did not reach Water World.");
        }

        BeginTransition(FoundationStage.ActiveWaterCycle);
        var startYear = elapsedYears;
        try
        {
            var result = Run.SimulateWaterWorld(disposeCancellationTokenSource.Token);
            foreach (var frame in result.Frames)
            {
                disposeCancellationTokenSource.Token.ThrowIfCancellationRequested();
                elapsedYears = startYear + frame.Year;
                StateHasChanged();
                await Task.Delay(HydrologyFrameDelayMilliseconds, disposeCancellationTokenSource.Token);
            }

            ApplyRun(result.Run);
            currentStage = FoundationStage.ActiveWaterCycle;
            await SyncPlanetAsync();
            if (waterRendererModule is not null && result.Frames.Count > 0)
            {
                await waterRendererModule.InvokeVoidAsync("setWaterCycle", disposeCancellationTokenSource.Token, result.Frames[^1].State);
            }
        }
        finally
        {
            EndTransition();
        }
    }

    private async Task SimulateScaffoldStageAsync(FoundationStage nextStage, double transitionYears)
    {
        BeginTransition(nextStage);
        var startYear = elapsedYears;
        try
        {
            for (var frame = 1; frame <= ScaffoldFrameCount; frame++)
            {
                disposeCancellationTokenSource.Token.ThrowIfCancellationRequested();
                elapsedYears = startYear + (transitionYears * frame / ScaffoldFrameCount);
                StateHasChanged();
                await Task.Delay(ScaffoldFrameDelayMilliseconds, disposeCancellationTokenSource.Token);
            }

            currentStage = nextStage;
        }
        finally
        {
            EndTransition();
        }
    }

    private async Task ResetAsync()
    {
        BeginTransition(FoundationStage.FrozenWorld);
        try
        {
            if (regionalStreamingEnabled)
            {
                RegionStream.Reset();
            }
            ApplyRun(Run.Restart());
            currentStage = FoundationStage.FrozenWorld;
            elapsedYears = 0.0;
            await SyncPlanetAsync();
            if (waterRendererModule is not null)
            {
                await waterRendererModule.InvokeVoidAsync("clearWaterCycle", disposeCancellationTokenSource.Token);
            }
        }
        finally
        {
            EndTransition();
        }
    }

    private void BeginTransition(FoundationStage targetStage)
    {
        isTransitioning = true;
        transitionStage = targetStage;
        StateHasChanged();
    }

    private void EndTransition()
    {
        transitionStage = null;
        isTransitioning = false;
        StateHasChanged();
    }

    private void ApplyRun(PlanetRunSnapshot nextRun)
    {
        run = nextRun;
        snapshot = nextRun.Mission.Planet;
    }

    private async Task SyncPlanetAsync()
    {
        if (snapshot is null)
        {
            return;
        }

        if (rendererModule is not null)
        {
            await rendererModule.InvokeVoidAsync("setPlanet", disposeCancellationTokenSource.Token, snapshot);
        }

    }

    private string PlanetVisualClass()
        => currentStage is FoundationStage.FrozenWorld or FoundationStage.MeltingWorld or FoundationStage.ActiveWaterCycle or FoundationStage.FirstLife or FoundationStage.MarineAnimals
            ? "pre-vegetation-world"
            : string.Empty;

    private string FormatStageLabel()
    {
        var displayedStage = transitionStage ?? currentStage;
        return isTransitioning && transitionStage is not null
            ? $"{StageName(currentStage)} → {StageName(displayedStage)}"
            : StageName(displayedStage);
    }

    private string FormatButtonLabel() => isTransitioning ? "SIMULATING…" : currentStage == FoundationStage.LandAnimals ? "RESET" : "NEXT";

    private string FormatElapsedTime()
    {
        if (elapsedYears < 1_000.0)
        {
            return $"YEAR {elapsedYears:0}";
        }

        if (elapsedYears < 1_000_000.0)
        {
            return $"{elapsedYears / 1_000.0:0.0} kyr";
        }

        return $"{elapsedYears / 1_000_000.0:0.0} Myr";
    }

    private static string StageName(FoundationStage stage)
        => stage switch
        {
            FoundationStage.FrozenWorld => "SNOWBALL EXPERIMENT",
            FoundationStage.MeltingWorld => "MELTING WORLD",
            FoundationStage.ActiveWaterCycle => "ACTIVE WATER CYCLE",
            FoundationStage.FirstLife => "FIRST LIFE",
            FoundationStage.MarineAnimals => "MARINE ANIMALS",
            FoundationStage.LandVegetation => "LAND VEGETATION",
            FoundationStage.LandAnimals => "LAND ANIMALS",
            _ => throw new ArgumentOutOfRangeException(nameof(stage), stage, null),
        };

    public async ValueTask DisposeAsync()
    {
        disposeCancellationTokenSource.Cancel();
        if (geologyActive)
        {
            TerrainProvider.ClearGlobalCrustDeformation();
            geologyActive = false;
        }
        if (regionalStreamingEnabled)
        {
            RegionStream.Reset();
        }
        if (archiveModule is not null)
        {
            try
            {
                await archiveModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Browser navigated away.
            }
        }
        if (waterRendererModule is not null)
        {
            try
            {
                await waterRendererModule.InvokeVoidAsync("dispose", CancellationToken.None);
                await waterRendererModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (rendererModule is not null)
        {
            try
            {
                await rendererModule.InvokeVoidAsync("dispose", CancellationToken.None);
                await rendererModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        DisposeSurfaceLodReference();
        disposeCancellationTokenSource.Dispose();
    }

    private enum FoundationStage
    {
        FrozenWorld,
        MeltingWorld,
        ActiveWaterCycle,
        FirstLife,
        MarineAnimals,
        LandVegetation,
        LandAnimals,
    }
}