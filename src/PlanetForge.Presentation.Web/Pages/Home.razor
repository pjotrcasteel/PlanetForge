@using System.Text.Json
@using PlanetForge.Application.Missions
@using PlanetForge.Application.Runs
@using PlanetForge.Domain.Atmosphere
@using PlanetForge.Domain.Hydrology
@using PlanetForge.Domain.Physics
@implements IAsyncDisposable
@inject PlanetExperience Experience
@inject PlanetRun Run
@inject IJSRuntime JsRuntime

<main class="game-shell run-game-shell">
    <header class="run-topbar">
        <div>
            <span class="eyebrow">PLANETFORGE 0.0.6.1 · PLANET RUN</span>
            <h1>Forge one world through deep time.</h1>
        </div>
        <div class="run-topbar-status">
            <strong>@FormatCurrentEra()</strong>
            <span>@(run?.Insight ?? 0) Insight · Seed @snapshot?.Seed</span>
        </div>
    </header>

    @if (!sandboxMode && run is not null)
    {
        <nav class="era-ribbon" aria-label="Planetary eras">
            @foreach (var eraDefinition in Run.Eras)
            {
                <div class="era-ribbon-node @EraClass(eraDefinition.Era)" title="@eraDefinition.ScientificPrerequisite">
                    <span>@((int)eraDefinition.Era + 1)</span>
                    <strong>@eraDefinition.Name</strong>
                </div>
            }
        </nav>
    }

    <section class="planet-stage @PlanetVisualClass()">
        <canvas id="planet-canvas" aria-label="Interactive simulated planet"></canvas>
        <div class="stage-metrics compact-stage-metrics">
            <span>@FormatSurfaceTemperature()</span>
            <span>@FormatCryosphere()</span>
            <span>@FormatWaterState()</span>
        </div>
        @if (isSimulating)
        {
            <div class="timelapse-overlay">
                <span>SIMULATING CLIMATE RESPONSE</span>
                <strong>YEAR +@timelineYear.ToString("0")</strong>
                <small>physical response shown in 10-year model steps</small>
            </div>
        }
        <div class="stage-hint">DRAG TO ORBIT · SCROLL / PINCH TO ZOOM</div>
    </section>

    @if (!sandboxMode && run is not null && mission is not null)
    {
        <section class="single-objective-bar">
            <div>
                <span class="eyebrow">CURRENT OBJECTIVE</span>
                <h2>@FormatCurrentEraGoal()</h2>
                <p>@FormatObjectiveExplanation()</p>
            </div>
            <div class="deep-time-key">
                <span>TIME SCALE</span>
                <strong>@FormatCurrentTimeScale()</strong>
                <small>Later geological and evolutionary eras will move into kyr and Myr.</small>
            </div>
        </section>

        @if (run.Era == PlanetRunEra.DeadRock && mission.Status == MissionStatus.Active)
        {
            <section class="intervention-strip" aria-label="Planetary interventions">
                @foreach (var intervention in Run.Interventions)
                {
                    <button class="intervention-choice @(PlanCount(intervention.Type) > 0 ? "selected" : string.Empty)"
                            disabled="@(isSimulating || !Run.CanAfford(intervention.Type))"
                            @onclick="() => PlanAsync(intervention.Type)">
                        <span>@intervention.ImpactLabel</span>
                        <strong>@intervention.Name</strong>
                        <small>@intervention.EffectPreview</small>
                        <em>@intervention.Cost capacity · @PlanCount(intervention.Type) queued</em>
                    </button>
                }
            </section>

            <section class="commit-dock">
                <div class="commit-summary">
                    <span class="eyebrow">YOUR PLAN</span>
                    <strong>@FormatCurrentPlan()</strong>
                    <small>@ReservedCredits() reserved · @mission.BudgetRemaining capacity left</small>
                </div>
                @if (mission.PlannedInterventions.Count > 0)
                {
                    <button class="quiet-button" disabled="@isSimulating" @onclick="ClearPlanAsync">Clear</button>
                }
                <button class="primary-button commit-watch-button"
                        disabled="@(isSimulating || mission.PlannedInterventions.Count == 0)"
                        @onclick="CommitAndWatchAsync">
                    @(isSimulating ? "SIMULATING…" : "COMMIT & WATCH")
                </button>
            </section>

            @if (mission.LastTurn is not null && !isSimulating)
            {
                <section class="outcome-line">
                    <div>
                        <span class="eyebrow">WHAT CHANGED</span>
                        <strong>@mission.LastTurn.Headline</strong>
                    </div>
                    <p>@mission.LastTurn.Explanation</p>
                </section>
            }
        }
        else if (mission.Status == MissionStatus.Failed)
        {
            <section class="chapter-transition failure-transition">
                <span class="eyebrow">THIS RUN STALLED</span>
                <h2>The frozen state never reached persistent liquid water.</h2>
                <p>The planet and journal show exactly where the trajectory ended. Start a fresh run and try a different physical strategy.</p>
                <button class="primary-button" @onclick="RestartRunAsync">Start a new world</button>
            </section>
        }
        else if (run.Era == PlanetRunEra.WaterWorld)
        {
            <section class="chapter-transition water-transition">
                <span class="eyebrow">ERA II · WATER WORLD</span>
                <h2>The ice has retreated enough for a persistent hydrological world.</h2>
                <p>This is not life yet. The next scientific question is spatial: where can the new liquid water collect and flow across this exact terrain?</p>

                @if (run.WaterSurvey is null)
                {
                    <button class="primary-button commit-watch-button" disabled="@isSimulating" @onclick="SurveyWaterWorldAsync">MAP WATER PATHWAYS</button>
                    <small>The survey derives drainage from topography. It does not pretend potential drainage is already rainfall or river discharge.</small>
                }
                else
                {
                    <div class="survey-result-line">
                        <strong>@run.WaterSurvey.WatershedCount drainage basins</strong>
                        <span>·</span>
                        <strong>@run.WaterSurvey.LakeCount closed depressions</strong>
                        <span>·</span>
                        <strong>@run.WaterSurvey.PotentialRiverSegmentCount potential high-flow segments</strong>
                    </div>
                    <p class="next-system-note">Next: make those pathways physically wet with rainfall, runoff, lakes and visible rivers. That is the Water World simulation we build next.</p>
                }
            </section>

            @if (run.ResearchChoiceAvailable)
            {
                <section class="research-strip">
                    <div>
                        <span class="eyebrow">CHOOSE ONE SCIENTIFIC CAPABILITY</span>
                        <strong>Spend Insight on what you want to understand better.</strong>
                    </div>
                    @foreach (var research in run.ResearchChoices)
                    {
                        <button disabled="@(run.Insight < research.InsightCost)" @onclick="() => SelectResearchAsync(research.Type)">
                            <strong>@research.Name</strong>
                            <small>@research.Capability</small>
                            <span>@research.InsightCost Insight</span>
                        </button>
                    }
                </section>
            }
        }

        <details class="run-details">
            <summary>Planet Journal · @run.Journal.Count events</summary>
            <div class="journal-list compact-journal-list">
                @foreach (var entry in run.Journal.OrderByDescending(value => value.Year))
                {
                    <article>
                        <div class="journal-time">YEAR +@entry.Year.ToString("0")</div>
                        <div><strong>@entry.Title</strong><p>@entry.Description</p></div>
                        @if (entry.InsightAwarded > 0)
                        {
                            <span class="journal-insight">+@entry.InsightAwarded</span>
                        }
                    </article>
                }
            </div>
        </details>

        <details class="run-details science-details">
            <summary>Why did the planet change?</summary>
            <p>@FormatDiagnosis()</p>
            <div class="formula-list compact-formulas">
                <div><span>Stellar energy</span><code>F ∝ 1 / d²</code></div>
                <div><span>CO₂ forcing</span><code>ΔF = 5.35 ln(C / C₀)</code></div>
                <div><span>Ice feedback</span><code>αeff = αbase + 0.28 · fcryosphere</code></div>
            </div>
        </details>

        <button class="sandbox-link" @onclick="ToggleSandboxAsync">Advanced scientific sandbox</button>
    }
    else if (sandboxMode)
    {
        <section class="sandbox-surface">
            <div class="section-heading">
                <div><span class="eyebrow">ADVANCED SANDBOX</span><h2>Direct model controls</h2></div>
                <button @onclick="ToggleSandboxAsync">Return to Planet Run</button>
            </div>
            <section class="compact-sandbox-controls">
                <button @onclick="MoveOrbitInwardAsync">Orbit −0.1 AU</button>
                <button @onclick="MoveOrbitOutwardAsync">Orbit +0.1 AU</button>
                <button @onclick="DoubleCarbonDioxideAsync">2× CO₂</button>
                <button @onclick="HalveCarbonDioxideAsync">½ CO₂</button>
                <button @onclick="DarkenSurfaceAsync">Darker surface</button>
                <button @onclick="BrightenSurfaceAsync">Brighter surface</button>
                <button @onclick="AdvanceTenYearsAsync">+10 years</button>
                <button @onclick="AdvanceFiftyYearsAsync">+50 years</button>
            </section>
        </section>
    }
</main>

@code {
    private readonly CancellationTokenSource disposeCancellationTokenSource = new();
    private IJSObjectReference? rendererModule;
    private IJSObjectReference? persistenceModule;
    private PlanetRenderSnapshot? snapshot;
    private PlanetRunSnapshot? run;
    private MissionSnapshot? mission;
    private PlanetRunSave? sandboxReturnSave;
    private bool sandboxMode;
    private bool isSimulating;
    private double timelineYear;

    protected override void OnInitialized() => ApplyRun(Run.StartNew());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || snapshot is null)
        {
            return;
        }

        persistenceModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", disposeCancellationTokenSource.Token, "./js/runPersistence.js");
        var savedJson = await persistenceModule.InvokeAsync<string?>("load", disposeCancellationTokenSource.Token);
        if (!string.IsNullOrWhiteSpace(savedJson))
        {
            try
            {
                var save = JsonSerializer.Deserialize<PlanetRunSave>(savedJson);
                if (save is not null)
                {
                    ApplyRun(Run.Restore(save));
                }
            }
            catch (JsonException)
            {
                ApplyRun(Run.StartNew());
            }
            catch (NotSupportedException)
            {
                ApplyRun(Run.StartNew());
                await SaveRunAsync();
            }
        }
        else
        {
            await SaveRunAsync();
        }

        rendererModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", disposeCancellationTokenSource.Token, "./js/planetRenderer.js");
        await rendererModule.InvokeVoidAsync("initialize", disposeCancellationTokenSource.Token, "planet-canvas", snapshot, GetOrCreateSurfaceLodReference());
        StateHasChanged();
    }

    private async Task PlanAsync(MissionInterventionType type) => await ApplyRunAsync(Run.QueueIntervention(type), updatePlanet: false);
    private async Task ClearPlanAsync() => await ApplyRunAsync(Run.ClearPlan(), updatePlanet: false);
    private async Task SelectResearchAsync(PlanetResearchUnlock research) => await ApplyRunAsync(Run.SelectResearch(research), updatePlanet: false);
    private async Task RestartRunAsync() => await ApplyRunAsync(Run.Restart(), updatePlanet: true);

    private async Task CommitAndWatchAsync()
    {
        if (isSimulating)
        {
            return;
        }

        isSimulating = true;
        var result = Run.SimulateCommit();
        try
        {
            foreach (var frame in result.Frames)
            {
                disposeCancellationTokenSource.Token.ThrowIfCancellationRequested();
                timelineYear = frame.Year;
                snapshot = frame.Planet;
                if (rendererModule is not null)
                {
                    await rendererModule.InvokeVoidAsync("setPlanet", disposeCancellationTokenSource.Token, snapshot);
                }

                StateHasChanged();
                await Task.Delay(280, disposeCancellationTokenSource.Token);
            }

            ApplyRun(result.Run);
            await SaveRunAsync();
        }
        finally
        {
            isSimulating = false;
            StateHasChanged();
        }
    }

    private async Task SurveyWaterWorldAsync()
        => await ApplyRunAsync(Run.SurveyWaterWorld(disposeCancellationTokenSource.Token), updatePlanet: false);

    private async Task ToggleSandboxAsync()
    {
        if (!sandboxMode)
        {
            sandboxReturnSave = Run.ExportSave();
            sandboxMode = true;
            return;
        }

        sandboxMode = false;
        if (sandboxReturnSave is not null)
        {
            await ApplyRunAsync(Run.Restore(sandboxReturnSave), updatePlanet: true);
            sandboxReturnSave = null;
        }
    }

    private Task AdvanceTenYearsAsync() => UpdateSandboxAsync(Experience.AdvanceClimate(10.0));
    private Task AdvanceFiftyYearsAsync() => UpdateSandboxAsync(Experience.AdvanceClimate(50.0));
    private Task MoveOrbitInwardAsync() => UpdateSandboxAsync(Experience.MoveOrbitInward());
    private Task MoveOrbitOutwardAsync() => UpdateSandboxAsync(Experience.MoveOrbitOutward());
    private Task DarkenSurfaceAsync() => UpdateSandboxAsync(Experience.DarkenSurface());
    private Task BrightenSurfaceAsync() => UpdateSandboxAsync(Experience.BrightenSurface());
    private Task HalveCarbonDioxideAsync() => UpdateSandboxAsync(Experience.HalveCarbonDioxide());
    private Task DoubleCarbonDioxideAsync() => UpdateSandboxAsync(Experience.DoubleCarbonDioxide());

    private void ApplyRun(PlanetRunSnapshot nextRun)
    {
        run = nextRun;
        mission = nextRun.Mission;
        snapshot = mission.Planet;
        timelineYear = mission.MissionYearsElapsed;
    }

    private async Task ApplyRunAsync(PlanetRunSnapshot nextRun, bool updatePlanet)
    {
        ApplyRun(nextRun);
        if (updatePlanet && rendererModule is not null)
        {
            await rendererModule.InvokeVoidAsync("setPlanet", disposeCancellationTokenSource.Token, snapshot);
        }

        await SaveRunAsync();
    }

    private async Task SaveRunAsync()
    {
        if (persistenceModule is null)
        {
            return;
        }

        var json = JsonSerializer.Serialize(Run.ExportSave());
        await persistenceModule.InvokeVoidAsync("save", disposeCancellationTokenSource.Token, json);
    }

    private async Task UpdateSandboxAsync(PlanetRenderSnapshot nextSnapshot)
    {
        snapshot = nextSnapshot;
        if (rendererModule is not null)
        {
            await rendererModule.InvokeVoidAsync("setPlanet", disposeCancellationTokenSource.Token, snapshot);
        }
    }

    private int PlanCount(MissionInterventionType type) => mission?.PlannedInterventions.Count(value => value == type) ?? 0;
    private int ReservedCredits() => mission?.PlannedInterventions.Sum(type => Run.GetDefinition(type).Cost) ?? 0;

    private string FormatCurrentPlan()
        => mission is null || mission.PlannedInterventions.Count == 0
            ? "Choose one or more interventions."
            : string.Join(" + ", mission.PlannedInterventions.GroupBy(type => type).Select(group => $"{group.Count()}× {Run.GetDefinition(group.Key).Name}"));

    private string FormatCurrentEra() => run is null ? "—" : Run.Eras.Single(value => value.Era == run.Era).Name;
    private string FormatCurrentEraGoal() => run is null ? "—" : Run.Eras.Single(value => value.Era == run.Era).Goal;
    private string EraClass(PlanetRunEra value) => run is null ? "era-locked" : value < run.Era ? "era-complete" : value == run.Era ? "era-current" : "era-locked";
    private string PlanetVisualClass() => run is not null && run.Era < PlanetRunEra.GreenWorld ? "pre-vegetation-world" : string.Empty;

    private string FormatObjectiveExplanation()
        => run?.Era switch
        {
            PlanetRunEra.DeadRock => "Choose a physical intervention, commit it once, then watch the climate evolve until the response becomes meaningful. You are changing forcing; the planet supplies the consequences.",
            PlanetRunEra.WaterWorld => "Stable liquid water exists. Now map how topography routes it before we add rainfall, runoff and visible rivers.",
            _ => "The next era unlocks only when its scientific prerequisites are actually modelled and met.",
        };

    private string FormatCurrentTimeScale()
        => run?.Era switch
        {
            PlanetRunEra.DeadRock => "YEARS → CENTURIES",
            PlanetRunEra.WaterWorld => "YEARS → KYR",
            PlanetRunEra.FirstLife => "KYR → MYR",
            _ => "MYR",
        };

    private string FormatDiagnosis()
    {
        if (snapshot is null)
        {
            return "Collecting planetary data…";
        }

        return $"The surface is {FormatSurfaceTemperature()}, the current forcing points toward {FormatTargetSurfaceTemperature()}, and {FormatCryosphere()} of the surface is in the cryosphere. Changes in ice cover alter effective albedo, so the planet can amplify the intervention through feedback.";
    }

    private string FormatSurfaceTemperature() => snapshot is null ? "—" : FormatTemperature(snapshot.Climate.SurfaceTemperatureKelvin);
    private string FormatTargetSurfaceTemperature() => snapshot is null ? "—" : FormatTemperature(snapshot.ClimateFeedback.TargetSurfaceTemperatureKelvin);
    private string FormatCryosphere() => snapshot is null ? "—" : $"{snapshot.ClimateFeedback.CryosphereFraction * 100:0}% ICE";

    private string FormatWaterState()
    {
        if (snapshot is null || snapshot.WaterParameters.TotalMassKilograms <= 0.0)
        {
            return "DRY";
        }

        if (snapshot.Water.LiquidFraction >= snapshot.Water.IceFraction && snapshot.Water.LiquidFraction >= snapshot.Water.VaporFraction)
        {
            return "LIQUID WATER";
        }

        return snapshot.Water.IceFraction >= snapshot.Water.VaporFraction ? "ICE WORLD" : "STEAM WORLD";
    }

    private static string FormatTemperature(double kelvin)
    {
        var celsius = kelvin - PhysicalConstants.KelvinOffsetCelsius;
        return $"{celsius:+0.0;-0.0;0.0}°C";
    }

    public async ValueTask DisposeAsync()
    {
        disposeCancellationTokenSource.Cancel();
        if (rendererModule is not null)
        {
            try
            {
                await rendererModule.InvokeVoidAsync("dispose", CancellationToken.None);
                await rendererModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (persistenceModule is not null)
        {
            try
            {
                await persistenceModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        DisposeSurfaceLodReference();
        disposeCancellationTokenSource.Dispose();
    }
}