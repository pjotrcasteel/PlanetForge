    private async Task AdvanceAirlessReferenceAsync()
    {
        if (!airlessReferenceActive || airlessBusy) return;
        airlessBusy = true;
        airlessStatus = "INTEGRATING HEAT TRANSFER…";
        StateHasChanged();
        await Task.Yield();

        try
        {
            if (regionalRockActive)
            {
                var current = Experience.PublishedRegionalRock ??
                    throw new InvalidOperationException("Publish a canonical regional epoch first.");
                var advanced = rockColumnsActive
                    ? PlanetRockColumnReference.Advance(current, Experience.CreateSnapshot(), disposeCancellationTokenSource.Token)
                    : PlanetRegionalCoolingReference.Advance(current, Experience.CreateSnapshot(), disposeCancellationTokenSource.Token);
                snapshot = Experience.PublishRegionalRock(advanced);
            }
            else
            {
                snapshot = PlanetAirlessCoolingReference.Advance(Experience, disposeCancellationTokenSource.Token);
            }
            await SyncPlanetAsync();
            if (rendererModule is not null)
            {
                await rendererModule.InvokeVoidAsync("waitForVisibleTerrain", disposeCancellationTokenSource.Token);
            }
            airlessElapsedSeconds += PlanetAirlessCoolingReference.AdvanceSeconds;
            airlessStatus = "ACCEPTED";
        }
        catch (Exception error) when (error is not OperationCanceledException)
        {
            airlessStatus = $"REFERENCE STEP FAILED: {error.Message}";
        }
        finally
        {
            airlessBusy = false;
            StateHasChanged();
        }
    }

