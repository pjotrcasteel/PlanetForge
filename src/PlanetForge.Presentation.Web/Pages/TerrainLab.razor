@using PlanetForge.Domain.Surface
@using PlanetForge.Domain.WorldGeneration
@using PlanetForge.Infrastructure.Surface
@implements IAsyncDisposable
@inject ProceduralPlanetElevationSource Elevation
@inject IJSRuntime Js

<div class="terrain-lab">
    <header class="lab-top">
        <div>
            <small>PLANETFORGE / RESEARCH TOOLING</small>
            <h1>Terrain Lab</h1>
            <p>One canonical spherical generator, four observable geological layers. No ice, atmosphere, oceans or orbital exaggeration hiding the terrain.</p>
        </div>
        <a class="lab-back" href="./">← Return to planet</a>
    </header>
    <section class="lab-controls" aria-label="Terrain lab controls">
        <label for="lab-seed">World seed</label>
        <select id="lab-seed" @bind="selectedSeed" disabled="@working">
            @foreach (var seed in PlanetSeedCatalog.IntegritySeeds)
            {
                <option value="@seed">@seed@(seed == PlanetSeedCatalog.ShowcaseSeed ? " / showcase" : "")</option>
            }
        </select>
        <button @onclick="RegenerateAsync" disabled="@working">@(working ? "GENERATING…" : "REGENERATE")</button>
        <span role="status">@status</span>
    </section>
    <section class="lab-grid">
        <article>
            <h2>01 / Crust potential</h2>
            <p>Multiscale continental substrate, before uplift. Irregularity should originate here.</p>
            <canvas id="lab-crust" width="256" height="128" aria-label="Crust potential global map"></canvas>
        </article>
        <article>
            <h2>02 / Tectonic uplift</h2>
            <p>Plate interaction drives regional relief, not continent silhouettes.</p>
            <canvas id="lab-tectonic" width="256" height="128" aria-label="Tectonic uplift global map"></canvas>
        </article>
        <article>
            <h2>03 / Mountain provinces</h2>
            <p>Connected highland envelopes; future drainage and erosion will cut these.</p>
            <canvas id="lab-mountains" width="256" height="128" aria-label="Mountain belts global map"></canvas>
        </article>
        <article>
            <h2>04 / Canonical terrain</h2>
            <p>Elevation plus terrain-aware hillshading. Blue marks elevation below datum, not simulated water.</p>
            <canvas id="lab-elevation" width="256" height="128" aria-label="Canonical planetary elevation global map"></canvas>
        </article>
    </section>
    <section class="lab-regional" aria-label="Regional watershed diagnostics">
        <h2>Regional hydrology / experimental</h2>
        <div class="lab-evolution">
            <label for="lab-erosion-iterations">Geological erosion iterations</label>
            <select id="lab-erosion-iterations" @bind="selectedIterations" @bind:after="AdvanceRegionAsync" disabled="@(working || baselineRegion is null)">
                <option value="0">0 / original bedrock</option>
                <option value="1">1 / first pass</option>
                <option value="5">5 / repeated erosion</option>
                <option value="12">12 / evolved preview</option>
            </select>
            <span>Numerical passes, not calibrated geological years</span>
        </div>
        <p>One deterministic high-relief location per seed. The regional model samples canonical bedrock at approximately 6 km spacing and routes runoff toward real low points and open boundaries. These maps do not yet alter gameplay elevation.</p>
        <div class="lab-grid">
            <article>
                <h2>05 / Regional bedrock</h2>
                <p>Sampled topography before erosion. This defines every downstream route.</p>
                <canvas id="lab-regional-bedrock" width="96" height="96" aria-label="Regional canonical bedrock map"></canvas>
            </article>
            <article>
                <h2>06 / Connected catchments</h2>
                <p>Accumulated runoff from connected downhill routing, not drawn river noise.</p>
                <canvas id="lab-regional-flow" width="96" height="96" aria-label="Regional watershed flow accumulation map"></canvas>
            </article>
            <article>
                <h2>07 / Incision and sediment</h2>
                <p>Stream power removes material from connected channels; deposition is conserved with exported sediment.</p>
                <canvas id="lab-regional-incision" width="96" height="96" aria-label="Regional stream power incision map"></canvas>
                <canvas id="lab-regional-sediment" width="96" height="96" aria-label="Regional sediment deposition map"></canvas>
            </article>
            <article>
                <h2>08 / Eroded elevation</h2>
                <p>Actual evolved height after the selected numerical passes. No visual vertical exaggeration.</p>
                <canvas id="lab-regional-evolved" width="96" height="96" aria-label="Regional eroded geological elevation map"></canvas>
            </article>
            <article>
                <h2>09 / Cumulative elevation change</h2>
                <p>Diagnostic only: orange is rock removed, turquoise is deposited material. Color shows physical metres of change, not exaggerated terrain.</p>
                <canvas id="lab-regional-difference" width="96" height="96" aria-label="Regional erosion and deposition height difference map"></canvas>
            </article>
        </div>
    </section>
    <section class="lab-hero" aria-label="Three-dimensional geological hero region">
        <div class="lab-hero-heading">
            <div>
                <small>PF 0.0.36 / WORLD MACHINE-INSPIRED RESEARCH</small>
                <h2>Hero region / 128 km of real geological relief</h2>
                <p>Generate a 129×129 terrain mesh from canonical bedrock, then apply six actual erosion passes.
                    The terrain is displayed at physical scale, without vertical exaggeration or fake shader displacement.</p>
            </div>
            <button id="lab-hero-generate" @onclick="GenerateHeroRegionAsync" disabled="@(working || heroAnchor is null)">
                @(working ? "WORKING…" : "GENERATE 3D TERRAIN")
            </button>
        </div>
        <div class="lab-hero-toolbar">
            <label for="lab-hero-mode">Compare terrain</label>
            <select id="lab-hero-mode" @bind="heroMode" @bind:after="UpdateHeroModeAsync" disabled="@(heroRegion is null || working)">
                <option value="after">Eroded geological terrain</option>
                <option value="before">Original geological bedrock</option>
            </select>
            <span>Drag to orbit · Scroll to zoom · 128 km physical scale</span>
        </div>
        <canvas id="lab-hero-render" width="960" height="540" aria-label="Interactive 3D landscape from eroded geological height data"></canvas>
        <p class="lab-hero-status" aria-live="polite">@heroStatus</p>
    </section>
    <footer class="lab-footer">Equirectangular projections are diagnostic maps only. Gameplay and local terrain sample these exact same elevation fields. The current generator does not yet simulate hydraulic erosion.</footer>
</div>

@code {
    private const int MapWidth = 256;
    private const int MapHeight = 128;
    private const int RegionSize = 96;
    private const double RegionSpanMeters = 576_000.0;
    private const double ReferencePlanetRadiusMeters = 6_371_000.0;
    private PlanetRegionalGeologySnapshot? baselineRegion;
    private PlanetRegionalGeologySnapshot? evolvedRegion;
    private float[]? regionalBedrock;
    private int selectedIterations;
    private readonly CancellationTokenSource cancellation = new();
    private PlanetVector? heroAnchor;
    private PlanetHeroRegion? heroRegion;
    private IJSObjectReference? heroModule;
    private string heroMode = "after";
    private string heroStatus = "Generate the hero region to inspect real eroded 3D terrain.";
    private IJSObjectReference? module;
    private int selectedSeed = PlanetSeedCatalog.ShowcaseSeed;
    private bool working;
    private string status = "Initializing laboratory…";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            module = await Js.InvokeAsync<IJSObjectReference>("import", cancellation.Token, "./js/terrainLab.js");
            await RegenerateAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            status = $"Terrain lab initialization failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RegenerateAsync()
    {
        if (working || module is null)
        {
            return;
        }

        working = true;
        heroAnchor = null;
        heroRegion = null;
        heroMode = "after";
        heroStatus = "Select Generate 3D Terrain after the canonical region finishes sampling.";
        if (heroModule is not null)
        {
            await heroModule.InvokeVoidAsync("resetHeroRegion", cancellation.Token);
        }

        status = $"Sampling seed {selectedSeed}…";
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            var crust = new float[MapWidth * MapHeight];
            var tectonic = new float[MapWidth * MapHeight];
            var mountains = new float[MapWidth * MapHeight];
            var elevations = new float[MapWidth * MapHeight];
            var land = 0;
            var minimum = double.MaxValue;
            var maximum = double.MinValue;

            for (var y = 0; y < MapHeight; y++)
            {
                cancellation.Token.ThrowIfCancellationRequested();
                var latitude = Math.PI * (0.5 - (y + 0.5) / MapHeight);
                var cosLatitude = Math.Cos(latitude);

                for (var x = 0; x < MapWidth; x++)
                {
                    var longitude = Math.PI * 2.0 * ((x + 0.5) / MapWidth);
                    var direction = new PlanetVector(cosLatitude * Math.Cos(longitude), Math.Sin(latitude), cosLatitude * Math.Sin(longitude));
                    var fields = Elevation.SampleTerrainFields(direction, selectedSeed);
                    var index = (y * MapWidth) + x;
                    crust[index] = (float)fields.ContinentalPotential;
                    tectonic[index] = (float)fields.TectonicUplift;
                    mountains[index] = (float)fields.MountainBelt;
                    elevations[index] = (float)fields.ElevationMeters;
                    if (fields.ElevationMeters > 0.0) land++;
                    minimum = Math.Min(minimum, fields.ElevationMeters);
                    maximum = Math.Max(maximum, fields.ElevationMeters);
                }

                if (y % 8 == 0)
                {
                    status = $"Sampling seed {selectedSeed} • {100 * (y + 1) / MapHeight}%";
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1, cancellation.Token);
                }
            }

            await module.InvokeVoidAsync("drawTerrainLab", cancellation.Token, MapWidth, MapHeight, crust, tectonic, mountains, elevations);

            // Select a real high-relief location rather than placing decorative rivers.
            // This is deterministic for the seed and remains stable through regeneration.
            var centerX = 0;
            var centerY = 0;
            var highestRelief = double.NegativeInfinity;
            for (var y = 1; y < MapHeight - 1; y++)
            {
                for (var x = 1; x < MapWidth - 1; x++)
                {
                    var i = y * MapWidth + x;
                    var gradient = Math.Abs(elevations[i + 1] - elevations[i - 1]) +
                        Math.Abs(elevations[i + MapWidth] - elevations[i - MapWidth]);
                    var relief = Math.Max(0, elevations[i]) * (gradient + 50.0) *
                        (0.5 + Math.Max(0.0, mountains[i]));
                    if (relief <= highestRelief)
                    {
                        continue;
                    }

                    highestRelief = relief;
                    centerX = x;
                    centerY = y;
                }
            }

            var anchorLatitude = Math.PI * (0.5 - (centerY + 0.5) / MapHeight);
            var anchorLongitude = 2.0 * Math.PI * (centerX + 0.5) / MapWidth;
            var anchor = new PlanetVector(Math.Cos(anchorLatitude) * Math.Cos(anchorLongitude),
                Math.Sin(anchorLatitude), Math.Cos(anchorLatitude) * Math.Sin(anchorLongitude));
            heroAnchor = anchor;
            var referenceElevation = Elevation.SampleElevationMeters(anchor, selectedSeed);
            var localFrame = PlanetLocalFrame.Create(anchor, ReferencePlanetRadiusMeters, referenceElevation);
            var regionalElevation = new float[RegionSize * RegionSize];
            var cellSizeMeters = RegionSpanMeters / RegionSize;
            status = $"Sampling 576 km watershed for seed {selectedSeed}…";
            await InvokeAsync(StateHasChanged);
            await Task.Yield();

            for (var y = 0; y < RegionSize; y++)
            {
                cancellation.Token.ThrowIfCancellationRequested();
                var northMeters = (y + 0.5 - RegionSize * 0.5) * cellSizeMeters;
                for (var x = 0; x < RegionSize; x++)
                {
                    var eastMeters = (x + 0.5 - RegionSize * 0.5) * cellSizeMeters;
                    var direction = PlanetVector.Normalize((anchor * ReferencePlanetRadiusMeters) +
                        (localFrame.East * eastMeters) + (localFrame.North * northMeters));
                    regionalElevation[y * RegionSize + x] = (float)Elevation.SampleElevationMeters(direction, selectedSeed);
                }

                if (y % 12 == 0)
                {
                    await Task.Delay(1, cancellation.Token);
                }
            }

            var regionKey = $"seed/{selectedSeed}/region/{centerX}/{centerY}/96";
            baselineRegion = PlanetRegionalGeologyEvolution.Initialize(selectedSeed, regionKey, RegionSize, RegionSize,
                cellSizeMeters, regionalElevation);
            regionalBedrock = regionalElevation;
            evolvedRegion = baselineRegion;
            selectedIterations = 0;
            var watershed = PlanetRegionalWatershed.Build(RegionSize, RegionSize, cellSizeMeters, regionalElevation);
            await module.InvokeVoidAsync("drawRegionalWatershed", cancellation.Token, RegionSize, RegionSize,
                regionalElevation, watershed.AccumulatedRunoffCells, watershed.IncisionMeters,
                watershed.SedimentDepositionMeters, regionalElevation, regionalElevation);
            status = $"Seed {selectedSeed} • above datum {land * 100.0 / elevations.Length:0.0}% • range {minimum:0}–{maximum:0} m • 0 erosion iterations";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            status = $"Generation failed: {ex.Message}";
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AdvanceRegionAsync()
    {
        if (working || baselineRegion is null || regionalBedrock is null || module is null)
        {
            return;
        }

        working = true;
        status = $"Advancing regional geology • {selectedIterations} iterations…";
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            // Advance the existing state when moving forward; restore the baseline only
            // when scrubbing backward. Both paths produce the same deterministic result.
            var state = evolvedRegion is not null && evolvedRegion.Iteration <= selectedIterations
                ? evolvedRegion : baselineRegion;
            var lastInput = state.ElevationMeters;
            for (var iteration = state.Iteration; iteration < selectedIterations; iteration++)
            {
                cancellation.Token.ThrowIfCancellationRequested();
                lastInput = state.ElevationMeters;
                state = PlanetRegionalGeologyEvolution.Advance(state, 1, cancellationToken: cancellation.Token);
                if (iteration % 2 == 0)
                {
                    await Task.Delay(1, cancellation.Token);
                }
            }

            evolvedRegion = state;
            // The display shows the actual most recent erosion step, not invented rivers
            // painted over the evolved surface. At iteration zero it is a potential first pass.
            var watershed = PlanetRegionalWatershed.Build(state.Width, state.Height, state.CellSpacingMeters, lastInput);
            await module.InvokeVoidAsync("drawRegionalWatershed", cancellation.Token, state.Width, state.Height,
                regionalBedrock, watershed.AccumulatedRunoffCells, watershed.IncisionMeters,
                watershed.SedimentDepositionMeters, state.ElevationMeters, regionalBedrock);
            var maxRemovedMeters = 0.0;
            var maxDepositedMeters = 0.0;
            for (var i = 0; i < regionalBedrock.Length; i++)
            {
                var difference = regionalBedrock[i] - state.ElevationMeters[i];
                maxRemovedMeters = Math.Max(maxRemovedMeters, difference);
                maxDepositedMeters = Math.Max(maxDepositedMeters, -difference);
            }

            status = $"Seed {selectedSeed} • {state.Iteration} erosion iterations • max cut {maxRemovedMeters:0.0} m • max fill {maxDepositedMeters:0.0} m • sediment exported {state.CumulativeExportedVolumeCubicMeters / 1e9:0.00} km³";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            status = $"Geological evolution failed: {ex.Message}";
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GenerateHeroRegionAsync()
    {
        if (working || heroAnchor is null)
        {
            return;
        }

        working = true;
        heroStatus = $"Building physical 3D terrain for seed {selectedSeed}. Erosion runs only when requested…";
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            heroModule ??= await Js.InvokeAsync<IJSObjectReference>("import", cancellation.Token, "./js/heroRegion.js");
            var result = new PlanetHeroRegionBuilder(Elevation).Build(
                heroAnchor.Value, selectedSeed, cancellationToken: cancellation.Token);
            heroMode = "after";
            await heroModule.InvokeVoidAsync("drawHeroRegion", cancellation.Token, result, heroMode);
            heroRegion = result;
            var relief = result.EvolvedElevationMeters.Max() - result.EvolvedElevationMeters.Min();
            heroStatus = $"Seed {selectedSeed} • {result.Width}² vertices • {relief:0} m actual relief • " +
                $"{result.ErosionIterations} erosion passes • deepest cut {result.CumulativeCutMeters.Max():0} m • " +
                $"sediment exported {result.ExportedVolumeCubicMeters / 1e9:0.00} km³";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            heroStatus = $"3D geological preview failed: {ex.Message}";
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task UpdateHeroModeAsync()
    {
        if (heroRegion is not null && heroModule is not null)
        {
            await heroModule.InvokeVoidAsync("setHeroRegionMode", cancellation.Token, heroMode);
        }
    }

    public async ValueTask DisposeAsync()
    {
        cancellation.Cancel();
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (heroModule is not null)
        {
            try
            {
                await heroModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        cancellation.Dispose();
    }
}
