<HeadContent>
    <title>PlanetForge 0.0.46.0 — Planetary Simulation</title>
    <meta name="description" content="PlanetForge procedural planet simulation." />
</HeadContent>

@inject NavigationManager Navigation

@if (Navigation.Uri.Contains("geologyArchive=1", StringComparison.OrdinalIgnoreCase))
{
    <GeologicalArchives />
}
else if (Navigation.Uri.Contains("geologyPreview=1", StringComparison.OrdinalIgnoreCase))
{
    <GeologyPreview />
}
else if (Navigation.Uri.Contains("terrainLab=1", StringComparison.OrdinalIgnoreCase))
{
    <TerrainLab />
}
else
{
    <Home />
}